# Servicio local: también sirve la interfaz web.
KBIT_HOST=127.0.0.1
KBIT_PORT=8000
# Si Node.js no está en PATH, indica la ruta absoluta de su ejecutable.
# KBIT_NODE=/ruta/a/node

# IBM Quantum: opcional. MILP (HiGHS) funciona sin estas credenciales.
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
KBIT_IBM_CHANNEL=ibm_quantum_platform

# Clave local del servicio, distinta de la API key de IBM.
# Para hardware, introduce esta misma clave en la interfaz al ejecutar el plan.
KBIT_API_KEY=
